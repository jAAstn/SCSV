{
	"name": "Steam Collection Size Viewer",
	"short_name": "SCSV",
	"description": "Calculate and sort Steam Workshop collection items by file size",
	"author": "Steam Collection Size Viewer",
	"version_name": "1.6",
	"minimum_chrome_version": "105",
	"version": "1.6",
	"manifest_version": 3,
	"icons":
	{
		"16": "./img/icon_16.png",
		"48": "./img/icon_48.png",
		"128": "./img/icon.png"
	},
	"action":
	{
		"default_icon": "./img/icon.png",
		"default_popup": "src/ui/popup/index.html"
	},
	"permissions": [
		"storage"
	],
	"host_permissions": [
		"https://steamcommunity.com/sharedfiles/filedetails/*",
		"https://steamcommunity.com/workshop/filedetails/*",
		"https://api.steampowered.com/*"
	],
	"content_security_policy":
	{
		"extension_pages": "script-src 'self'; object-src 'self'"
	},
	"content_scripts": [
	{
		"js": [
			"assets/index.ts-BZbTnqd5.js"
		],
		"matches": [
			"https://steamcommunity.com/sharedfiles/filedetails/*",
			"https://steamcommunity.com/workshop/filedetails/*",
			"https://steamcommunity.com/*/myworkshopfiles*",
			"https://steamcommunity.com/id/*/myworkshopfiles*"
		],
		"css": [
			"assets/index-TaLzIEIa.css"
		]
	}],
	"web_accessible_resources": [
	{
		"matches": [
			"https://steamcommunity.com/*",
			"https://steamcommunity.com/*"
		],
		"resources": [
			"assets/browser-polyfill-DX5UB71L.js",
			"assets/index.ts-BZbTnqd5.js"
		],
		"use_dynamic_url": false
	}]
}